# Database
POSTGRES_DB=clarivo
POSTGRES_USER=clarivo
POSTGRES_PASSWORD=clarivo
DATABASE_URL=postgresql+psycopg://clarivo:clarivo@localhost:5433/clarivo

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=clarivo-audio
S3_ACCESS_KEY=clarivo
S3_SECRET_KEY=clarivo-local-secret
S3_REGION=us-east-1
MAX_AUDIO_BYTES=26214400

# AI
OPENAI_API_KEY=

# Environment
APP_ENV=development
